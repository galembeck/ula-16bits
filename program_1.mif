-- Projeto CPU 16 bits | Lab. de Arquitetura de Sistemas Computacionais
-- Programa de teste 1: executa as 11 instruções da CPU.
-- Formato das instruções: [15-12] opcode | [11-9] Ri | [8-6] Rj | [5-3] Rk | [5-0] imediato | [11-0] end

DEPTH = 256;         -- numero de posições de memória
WIDTH = 16;          -- tamanho de cada palavra (bits)
ADDRESS_RADIX = DEC; -- base numerica do endereço (DEC, HEX, BIN)
DATA_RADIX = HEX;    -- base numerica dos dados (DEC, HEX, BIN)

CONTENT
BEGIN
    0   :   5205;   -- ADDI R1, R0, 5    | R1 = 5
    1   :   543D;   -- ADDI R2, R0, -3   | R2 = -3 (FFFD) -> imediato negativo
    2   :   0650;   -- ADD R3, R1, R2    | R3 = R1 + R2 = 2
    3   :   1850;   -- SUB R4, R1, R2    | R4 = R1 - R2 = 8
    4   :   2A60;   -- AND R5, R1, R4    | R5 = 0101 AND 1000 = 0 (zero = 1)
    5   :   3A60;   -- OR R5, R1, R4     | R5 = 0101 OR 1000 = 13 (000D)
    6   :   4C88;   -- SLT R6, R2, R1    | R6 = 1, pois -3 < 5 (comparação com sinal)
    7   :   7A1E;   -- ST R5, R0, 30     | Mem[30] = R5 = 000D
    8   :   6E1E;   -- LD R7, R0, 30     | R7 = Mem[30] = 000D
    9   :   8F41;   -- BEQ R7, R5, 1     | R7 = R5 -> desvia para 9 + 1 + 1 = 11
    10  :   5200;   -- ADDI R1, R0, 0    | PULADA pelo BEQ (se executar, R1 vira 0)
    11  :   5481;   -- ADDI R2, R2, 1    | laço: R2 = R2 + 1 (-2, -1, 0)
    12  :   943E;   -- BNE R2, R0, -2    | R2 != R0 -> volta para 12 + 1 - 2 = 11
    13  :   A00D;   -- JMP 13            | fim: laço infinito (PC fica em 13)
    [14..29] : 0000;   -- não utilizado
    30  :   00AA;   -- dado inicial (00AA): o ST sobrescreve com 000D; se o ST falhar, o LD lê 00AA
    [31..255] : 0000;   -- preenche com zero
END;
